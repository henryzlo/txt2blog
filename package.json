{
  "name": "txt2blog",
  "version": "0.1.0",
  "private": true,
  "description": "A daily static blog built from Telegram messages, run entirely in CI.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "collect": "node --env-file-if-exists=.env src/cli.ts collect",
    "build": "node --env-file-if-exists=.env src/cli.ts build",
    "preview": "node scripts/preview.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
