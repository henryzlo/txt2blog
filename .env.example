# Copy to .env for local runs. Never commit .env.

# From @BotFather (/newbot). Needed by `npm run collect` only.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. Only your messages are published.
TELEGRAM_OWNER_ID=

# Optional: blog title and the time zone used to group messages into days.
BLOG_TITLE=txt2blog
BLOG_TIMEZONE=America/New_York
